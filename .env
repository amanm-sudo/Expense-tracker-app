# SQLite database — path is relative to the prisma/ folder
DATABASE_URL=file:../db/custom.db

# Demo user session (legacy — kept for backward compat, not used when auth is active)
DEMO_USER_ID=demo-user-wealth-journal

# AI provider key (z-ai-web-dev-sdk reads this)
# Replace with your real key to enable AI insights on the Summary page.
ZAI_API_KEY=placeholder

# NextAuth — required for multi-user authentication
NEXTAUTH_SECRET=wealthjournal-super-secret-key-change-in-production-2026
NEXTAUTH_URL=http://localhost:3000
