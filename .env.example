# PostgreSQL database (Neon / Vercel Postgres / Supabase)
# Get yours from https://neon.tech — paste the pooled connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Demo user session (legacy, not used with auth active)
DEMO_USER_ID=demo-user-wealth-journal

# Gemini AI — get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# NextAuth — CHANGE NEXTAUTH_SECRET to a long random string in production!
NEXTAUTH_SECRET=your-super-secret-random-string-here
NEXTAUTH_URL=http://localhost:3000
