# PostgreSQL database (Neon / Vercel Postgres / Supabase)
# In Neon Console > Connect: enable pooling for DATABASE_URL.
# Disable pooling for DATABASE_URL_UNPOOLED (Prisma migrations).
# NEVER commit actual strings: keep them in .env.local or Vercel Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST.neon.tech/neondb?sslmode=require"

# Demo user session (legacy, not used with auth active)
DEMO_USER_ID=demo-user-wealth-journal

# Gemini AI — get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# NextAuth — CHANGE NEXTAUTH_SECRET to a long random string in production!
NEXTAUTH_SECRET=your-super-secret-random-string-here
NEXTAUTH_URL=http://localhost:3000
