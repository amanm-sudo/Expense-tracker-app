# SQLite database — path is relative to the prisma/ folder
DATABASE_URL=file:../db/custom.db

# Demo user session (legacy, not used with auth active)
DEMO_USER_ID=demo-user-wealth-journal

# AI provider key — replace with your real key for AI insights
ZAI_API_KEY=your_zai_api_key_here

# NextAuth — CHANGE NEXTAUTH_SECRET to a long random string in production!
NEXTAUTH_SECRET=your-super-secret-random-string-here
NEXTAUTH_URL=http://localhost:3000
