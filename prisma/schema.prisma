// Prisma schema for Wealth Journal expense tracker
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A registered user of Wealth Journal.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?  // bcrypt hash — null only for legacy demo user
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  months Month[]
}

/// A monthly ledger. `monthId` is the "YYYY-MM" key (e.g. "2026-06").
model Month {
  id        String   @id @default(cuid())
  userId    String
  monthId   String
  income    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emis      Emi[]
  expenses  Expense[]

  @@unique([userId, monthId])
  @@index([userId])
}

/// Recurring obligations / EMIs tied to a month.
model Emi {
  id        String   @id @default(cuid())
  monthId   String
  name      String
  amount    Float
  dueDate   Int      // day of month (1-31)
  isPaid    Boolean  @default(false)
  category  String   @default("Other")
  icon      String   @default("Globe")
  createdAt DateTime @default(now())

  month     Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@index([monthId])
}

/// Individual expense entries tied to a month.
/// `type` is either "expense" (default) or "credit" (income from any source).
model Expense {
  id          String   @id @default(cuid())
  monthId     String
  amount      Float
  category    String
  description String?
  name        String?
  date        String   // ISO date string "YYYY-MM-DD"
  type        String   @default("expense") // "expense" | "credit"
  createdAt   DateTime @default(now())

  month       Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@index([monthId])
  @@index([category])
}
