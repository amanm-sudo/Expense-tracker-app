// Prisma schema for Wealth Journal expense tracker
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// A registered user of Wealth Journal.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?  // bcrypt hash — null only for legacy demo user
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  months        Month[]
  importToken   ImportToken?
  importMode    String   @default("trusted") // "trusted" | "review"
  importQueue   ImportQueue[]
  merchantRules MerchantRule[]
}

/// Secret token used to authenticate the SMS forwarder webhook.
model ImportToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A UPI SMS that has been parsed and is awaiting user review.
model ImportQueue {
  id           String   @id @default(cuid())
  userId       String
  rawSms       String               // original SMS text
  smsFrom      String               // sender ID e.g. "CANBNK", "UBIBNK"
  amount       Float
  merchant     String?              // resolved merchant name
  vpa          String?              // UPI VPA e.g. "zomato@okaxis"
  upiRef       String?              // UPI reference number
  dedupeKey    String?              // stable hash fallback when upiRef is absent
  date         String               // ISO "YYYY-MM-DD"
  txnType      String  @default("expense") // "expense" | "credit"
  suggestedCat String               // auto-suggested category
  confidence   Float   @default(0)  // 0–1 parse × categorization confidence
  status       String  @default("pending") // "pending" | "approved" | "rejected"
  expenseId    String?              // set after approval → linked Expense id
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@unique([userId, dedupeKey]) // atomic SMS idempotency
}

/// User-taught merchant → category mapping (learned from review corrections).
model MerchantRule {
  id        String   @id @default(cuid())
  userId    String
  pattern   String               // VPA prefix or keyword e.g. "zomato"
  category  String               // mapped ExpenseCategory
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@index([userId])
}

/// A monthly ledger. `monthId` is the "YYYY-MM" key (e.g. "2026-06").
model Month {
  id        String   @id @default(cuid())
  userId    String
  monthId   String
  income    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emis      Emi[]
  expenses  Expense[]

  @@unique([userId, monthId])
  @@index([userId])
}

/// Recurring obligations / EMIs tied to a month.
model Emi {
  id        String   @id @default(cuid())
  monthId   String
  name      String
  amount    Float
  dueDate   Int      // day of month (1-31)
  isPaid    Boolean  @default(false)
  category  String   @default("Other")
  icon      String   @default("Globe")
  createdAt DateTime @default(now())

  month     Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@index([monthId])
}

/// Individual expense entries tied to a month.
/// `type` is either "expense" (default) or "credit" (income from any source).
model Expense {
  id          String   @id @default(cuid())
  monthId     String
  amount      Float
  category    String
  description String?
  name        String?
  date        String   // ISO date string "YYYY-MM-DD"
  type        String   @default("expense") // "expense" | "credit"
  createdAt   DateTime @default(now())

  month       Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@index([monthId])
  @@index([category])
}
